# Local Supabase only. Copy to .env (never commit .env).
# Values come from `bunx supabase status` / `supabase status`.
# API URL is usually http://127.0.0.1:54321
# Use the anon / publishable key, never service_role.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
