{
  "name": "ble-standmarket",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:visitor": "bun --filter visitor-mobile start",
    "dev:vendor": "bun --filter vendor-mobile start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "bun test",
    "db:start": "bunx supabase start",
    "db:stop": "bunx supabase stop",
    "db:reset": "bunx supabase db reset",
    "db:test": "bunx supabase test db",
    "db:lint": "bunx supabase db lint --local --schema public --level warning --fail-on warning"
  },
  "overrides": {
    "@expo/sudo-prompt": "file:./tooling/sudo-prompt-stub"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/bun": "latest",
    "eslint": "^9.32.0",
    "supabase": "^2.114.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.38.0"
  }
}
